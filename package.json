{
  "name": "@tsed/cli-root",
  "version": "7.6.0-beta.5",
  "private": true,
  "description": "CLI to bootstrap your Ts.ED project",
  "keywords": [
    "debug",
    "log",
    "trace",
    "ts",
    "typescript"
  ],
  "homepage": "https://github.com/tsedio/tsed-cli",
  "bugs": {
    "url": "https://github.com/tsedio/tsed-cli/issues"
  },
  "license": "MIT",
  "author": "Romain Lenzotti",
  "repository": {
    "type": "git",
    "url": "https://github.com/tsedio/tsed-cli.git"
  },
  "directories": {
    "test": "test",
    "packages": "packages"
  },
  "workspaces": {
    "packages": [
      "packages/*",
      "tools/*"
    ]
  },
  "type": "module",
  "scripts": {
    "postinstall": "cd docs && yarn install",
    "configure": "monorepo ci configure",
    "clean": "monorepo clean workspace",
    "test": "vitest run",
    "lint": "oxlint && oxfmt --check",
    "lint:fix": "oxlint --fix && oxfmt --write",
    "format": "oxfmt --check",
    "format:fix": "oxfmt --write",
    "build": "monorepo build --verbose",
    "build:references": "node ./tools/typescript",
    "build:vitest": "node ./tools/vitest/install.js",
    "sync:packages": "monorepo sync packages",
    "api:build": "rm -rf ./docs/api && tsc -b && tsdoc && cd docs && yarn docs:build:ai",
    "api:build:dev": "npx -p chokidar-cli chokidar \"docs/.templates/**/*.{js,ejs}\" -c \"tsdoc && && cd docs && yarn docs:build:ai\"",
    "docs:install": "cd docs && yarn install && cd ..",
    "docs:build": "yarn api:build && yarn vitepress:build",
    "docs:serve": "yarn api:build && yarn vitepress:serve",
    "docs:publish": "CI=1 monorepo publish ghpages",
    "vitepress:build": "cd ./docs && yarn docs:build",
    "vitepress:serve": "yarn docs:install && cd docs && yarn docs:dev",
    "release": "semantic-release",
    "release:dryRun": "semantic-release --dry-run",
    "prepare": "is-ci || husky install"
  },
  "dependencies": {
    "@clack/prompts": "^1.0.0-alpha.10",
    "@tsed/core": ">=8.38.0-beta.3",
    "@tsed/di": ">=8.38.0-beta.3",
    "@tsed/logger": ">=8.0.3",
    "@tsed/logger-std": ">=8.0.3",
    "@tsed/normalize-path": ">=8.38.0-beta.3",
    "@tsed/openspec": ">=8.38.0-beta.3",
    "@tsed/schema": ">=8.38.0-beta.3",
    "axios": "^1.7.7",
    "chalk": "^5.3.0",
    "commander": "^12.1.0",
    "consolidate": "^1.0.4",
    "execa": "8.0.1",
    "figures": "^6.1.0",
    "fs-extra": "^11.2.0",
    "js-yaml": "^4.1.0",
    "lerna": "^8.1.8",
    "read-package-up": "^12.0.0",
    "registry-auth-token": "^5.1.0",
    "registry-url": "^7.2.0",
    "rxjs": "^7.8.1",
    "semver": "7.6.3",
    "split": "^1.0.1",
    "tslib": "^2.7.0",
    "update-notifier": "^7.3.1"
  },
  "devDependencies": {
    "@commitlint/cli": "19.5.0",
    "@commitlint/config-conventional": "19.5.0",
    "@swc/core": "1.7.26",
    "@swc/helpers": "0.5.13",
    "@tsed/markdown-it-symbols": "3.20.8",
    "@tsed/monorepo-utils": "3.2.3",
    "@tsed/ts-doc": "5.0.4",
    "@types/node": "^24.1.0",
    "@vitest/coverage-v8": "4.1.0",
    "concurrently": "9.0.1",
    "cross-env": "7.0.3",
    "gflow": "^5.1.4",
    "husky": "9.1.6",
    "is-ci": "3.0.1",
    "lint-staged": "15.2.10",
    "markdown-it": "14.1.0",
    "oxfmt": "latest",
    "oxlint": "latest",
    "semantic-release": "24.1.2",
    "semantic-release-slack-bot": "4.0.2",
    "ts-node": "^10.9.2",
    "typescript": "6.0.3",
    "vitest": "4.1.0"
  },
  "packageManager": "yarn@4.18.0",
  "monorepo": {
    "productionBranch": "master",
    "developBranch": "master",
    "npmAccess": "public",
    "trustedPublishing": true,
    "ignoreSyncDependencies": [],
    "ghpages": [
      {
        "dir": "./docs/.vitepress/dist",
        "url": "https://github.com/tsedio/cli.tsed.dev.git",
        "branch": "gh-pages",
        "cname": "cli.tsed.dev",
        "if": "master"
      }
    ]
  }
}
