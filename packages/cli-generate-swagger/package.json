{
  "name": "@tsed/cli-generate-swagger",
  "version": "7.0.0-alpha.6",
  "description": "Ts.ED CLI plugin. Export a command that generate the swagger.json from your Ts.ED controllers and OS3 spec.",
  "source": "./src/index.ts",
  "type": "module",
  "main": "./lib/esm/index.js",
  "module": "./lib/esm/index.js",
  "typings": "./lib/types/index.d.ts",
  "exports": {
    ".": {
      "cli-tsed-source": "./src/index.ts",
      "types": "./lib/types/index.d.ts",
      "import": "./lib/esm/index.js",
      "default": "./lib/esm/index.js"
    }
  },
  "scripts": {
    "build": "yarn build:ts",
    "build:ts": "tsc --build tsconfig.esm.json",
    "/test": "vitest run",
    "/test:ci": "vitest run --coverage.thresholds.autoUpdate=true"
  },
  "dependencies": {
    "change-case": "5.4.4",
    "tslib": "2.7.0"
  },
  "devDependencies": {
    "@tsed/cli": "workspace:*",
    "@tsed/cli-core": "workspace:*",
    "@tsed/typescript": "workspace:*",
    "cross-env": "7.0.3",
    "typescript": "6.0.3",
    "vitest": "4.1.11"
  },
  "peerDependencies": {
    "@tsed/cli-core": ">=7.0.0",
    "@tsed/platform-express": ">=8.38.0",
    "@tsed/platform-fastify": ">=8.38.0",
    "@tsed/platform-koa": ">=8.38.0",
    "@tsed/swagger": ">=8.38.0"
  },
  "peerDependenciesMeta": {
    "@tsed/platform-express": {
      "optional": true
    },
    "@tsed/platform-fastify": {
      "optional": true
    },
    "@tsed/platform-koa": {
      "optional": true
    }
  }
}
