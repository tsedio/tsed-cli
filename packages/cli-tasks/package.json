{
  "name": "@tsed/cli-tasks",
  "version": "7.0.0-alpha.6",
  "description": "Task runner helpers shared across Ts.ED CLI packages",
  "keywords": [
    "clack",
    "cli",
    "tasks",
    "tsed"
  ],
  "source": "./src/index.ts",
  "type": "module",
  "main": "./lib/esm/index.js",
  "module": "./lib/esm/index.js",
  "typings": "./lib/types/index.d.ts",
  "exports": {
    ".": {
      "cli-tsed-source": "./src/index.ts",
      "types": "./lib/types/index.d.ts",
      "import": "./lib/esm/index.js",
      "default": "./lib/esm/index.js"
    }
  },
  "scripts": {
    "build": "yarn build:ts",
    "build:ts": "tsc --build tsconfig.esm.json",
    "test": "vitest run",
    "test:ci": "vitest run --coverage.thresholds.autoUpdate=true"
  },
  "dependencies": {
    "@clack/prompts": ">=1.0.0-alpha.10",
    "@tsed/core": ">=8.38.0-beta.3",
    "@tsed/di": ">=8.38.0-beta.3",
    "@tsed/hooks": ">=8.38.0-beta.3",
    "@tsed/logger": ">=8.0.3"
  },
  "devDependencies": {
    "@tsed/typescript": "workspace:*",
    "typescript": "6.0.3",
    "vitest": "4.1.0"
  }
}
